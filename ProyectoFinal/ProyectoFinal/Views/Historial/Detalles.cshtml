@model ProyectoFinal.ViewModels.AcademicHistoryViewModel

@{
    ViewData["Title"] = "Historial académico";
}

<h2>Historial académico del estudiante</h2>

<div class="card mb-3">
    <div class="card-body">
        <h4 class="card-title">@Model.NombreCompleto</h4>
        <p class="card-text">
            <strong>Matrícula:</strong> @Model.CodigoMatricula<br />
            <strong>Identificación:</strong> @Model.Identificacion<br />
            <strong>Correo:</strong> @Model.Correo
        </p>
    </div>
</div>

@if (Model.Registros != null && Model.Registros.Any())
{
    <h3>Detalle en tabla</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Cuatrimestre</th>
                <th>Código curso</th>
                <th>Curso</th>
                <th>Nota final</th>
                <th>Estado</th>
                <th>Fecha registro</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Registros)
            {
                <tr>
                    <td>@r.TerminoDescripcion</td>
                    <td>@r.CursoCodigo</td>
                    <td>@r.CursoNombre</td>
                    <td>@r.NotaFinal</td>
                    <td>@r.Estado</td>
                    <td>@r.FechaRegistro.ToLocalTime()</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- BLOQUE NUEVO: GRÁFICO -->
    <h3>Rendimiento académico (gráfico)</h3>
    <p>
        Visualización de las notas finales por curso y cuatrimestre.
    </p>
    <div class="mb-3">
        <canvas id="chartRendimiento" height="120"></canvas>
    </div>
}
else
{
    <div class="alert alert-info">
        Este estudiante aún no tiene registros académicos.
    </div>
}

<a asp-action="Buscar" class="btn btn-secondary">Volver a búsqueda</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Chart.js desde CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (function () {
            // Si no hay registros, no intentamos dibujar
            var tieneRegistros = @((Model.Registros != null && Model.Registros.Any()) ? "true" : "false");
            if (tieneRegistros !== "true") {
                return;
            }

            // URL al endpoint JSON (HistorialDatos)
            var dataUrl = '@Url.Action("HistorialDatos", "Historial", new { id = Model.EstudianteId })';

            fetch(dataUrl)
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error("No se pudieron cargar los datos del gráfico.");
                    }
                    return response.json();
                })
                .then(function (data) {
                    if (!data || data.length === 0) {
                        return;
                    }

                    // Construimos etiquetas y valores
                    var labels = data.map(function (item) {
                        return item.terminoDescripcion + " - " + item.cursoNombre;
                    });

                    var notas = data.map(function (item) {
                        return item.notaFinal;
                    });

                    var ctx = document.getElementById('chartRendimiento').getContext('2d');

                    var chart = new Chart(ctx, {
                        type: 'bar', // Puedes cambiar a 'line' si prefieres
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Nota final',
                                data: notas,
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    suggestedMin: 0,
                                    suggestedMax: 100,
                                    title: {
                                        display: true,
                                        text: 'Nota'
                                    }
                                },
                                x: {
                                    title: {
                                        display: true,
                                        text: 'Curso / Cuatrimestre'
                                    }
                                }
                            },
                            plugins: {
                                legend: {
                                    display: true
                                },
                                tooltip: {
                                    callbacks: {
                                        label: function (context) {
                                            return " Nota: " + context.parsed.y;
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(function (error) {
                    console.error(error);
                });
        })();
    </script>
}
