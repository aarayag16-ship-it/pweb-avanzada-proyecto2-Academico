@model ProyectoFinal.ViewModels.EditUserRolesViewModel

@{
    ViewData["Title"] = "Editar roles de usuario";
}

<h2>Editar roles de usuario</h2>

<div class="mb-3">
    <strong>Usuario:</strong> @Model.Email
</div>

<form asp-action="EditRoles" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="userId" value="@Model.UserId" />

    <table class="table">
        <thead>
            <tr>
                <th>Asignado</th>
                <th>Rol</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Roles)
            {
                <tr>
                    <td>
                        <input type="checkbox"
                               name="selectedRoles"
                               value="@role.Name"
                               @(role.Selected ? "checked" : "") />
                    </td>
                    <td>@role.Name</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-danger">
        @Html.ValidationSummary()
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
