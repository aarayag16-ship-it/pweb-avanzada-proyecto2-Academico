@model ProyectoFinal.ViewModels.ActivityLogFilterViewModel

@{
    ViewData["Title"] = "Bitácora de actividades";
}

<h2>Bitácora de actividades</h2>

<div class="alert alert-info">
    Consulte acciones como inicio de sesión, creación, edición y eliminación de datos,
    filtrando por usuario, módulo, acción, IP o rangos de fecha.
</div>

<form asp-action="Index" method="post" class="mb-4">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Usuario" class="form-label"></label>
            <input asp-for="Usuario" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Accion" class="form-label"></label>
            <input asp-for="Accion" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Modulo" class="form-label"></label>
            <input asp-for="Modulo" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Ip" class="form-label"></label>
            <input asp-for="Ip" class="form-control" />
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-md-3">
            <label asp-for="FechaDesde" class="form-label"></label>
            <input asp-for="FechaDesde" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="FechaHasta" class="form-label"></label>
            <input asp-for="FechaHasta" class="form-control" />
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar filtros</a>
        </div>
    </div>
</form>

@if (Model.Resultados != null && Model.Resultados.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Módulo</th>
                    <th>IP</th>
                    <th>Detalles</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Resultados)
                {
                    <tr>
                        <td>@log.FechaHora.ToLocalTime()</td>
                        <td>@log.UsuarioNombre</td>
                        <td>@log.Accion</td>
                        <td>@log.Modulo</td>
                        <td>@log.Ip</td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.DatosExtra))
                            {
                                var texto = log.DatosExtra.Length > 80
                                ? log.DatosExtra.Substring(0, 80) + "..."
                                : log.DatosExtra;

                                <span title="@log.DatosExtra">@texto</span>
                            }
                            else
                            {
                                <span class="text-muted">N/D</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">
        No hay registros para los filtros especificados.
    </div>
}
